.swiftpm/
# XcodeGen output, written from entitlements.properties in project.yml on every generate.
# Adopting a hand-written entitlements file means deleting this line in the same commit,
# or `git add` silently does nothing and a fresh clone gets a device build with no entitlement.
App/AnimalTracker.entitlements

# Supabase CLI scratch (version cache, linked-project ref, local branch name).
# `supabase start` and `supabase db reset` write .branches/_current_branch on every run.
supabase/.temp/
supabase/.branches/
